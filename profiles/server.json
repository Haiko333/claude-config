{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "autoCompactWindow": 200000,
  "bashOutputMaxChars": 12000,
  "disableClaudeAiConnectors": true,
  "syncClaudeAiSkills": false,
  "syncClaudeAiPlugins": false,
  "enableArtifact": false,
  "skillListingMaxDescChars": 300,
  "skillListingBudgetFraction": 0.004,
  "skillOverrides": {
    "impeccable": "off",
    "diagnose-crash": "off",
    "ma-config": "off",
    "find-skills": "off",
    "fix-grammar": "off",
    "contexte": "off",
    "projet-sync": "off",
    "resume-vault": "off",
    "dataviz": "off",
    "keybindings-help": "off",
    "update-config": "off",
    "fewer-permission-prompts": "off",
    "loop": "off",
    "schedule": "off",
    "run": "off",
    "plugin-authoring": "off",
    "workflow-authoring": "off",
    "init": "off",
    "claude-in-chrome": "off",
    "claude-api": "name-only",
    "animations": "off"
  },
  "enabledPlugins": {
    "superpowers@claude-plugins-official": false,
    "mattpocock-skills@claude-plugins-official": false,
    "ui-ux-pro-max@ui-ux-pro-max-skill": false,
    "hostinger-connector@anthropic-plugin-directory": false,
    "security-guidance@claude-plugins-official": false,
    "clangd-lsp@claude-plugins-official": false,
    "rust-analyzer-lsp@claude-plugins-official": false,
    "token-weather@h41k0-mods": false
  },
  "permissions": {
    "deny": [
      "Workflow",
      "ScheduleWakeup",
      "ReportFindings",
      "ListAgents",
      "SendMessage",
      "Artifact",
      "CronCreate",
      "RemoteTrigger",
      "PushNotification",
      "Agent(Explore)",
      "Agent(Plan)",
      "Read(~/.claude/.credentials.json)",
      "Read(~/.ssh/**)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Bash(sudo *)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git reset --hard origin*)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~*)",
      "Bash(docker system prune*)",
      "Bash(curl * | sh*)",
      "Bash(curl * | bash*)"
    ]
  },
  "env": {
    "CLAUDE_CODE_SUBAGENT_MODEL": "sonnet",
    "CLAUDE_CODE_DISABLE_ADVISOR_TOOL": "1",
    "MAX_MCP_OUTPUT_TOKENS": "10000",
    "CLAUDE_CODE_FILE_READ_MAX_OUTPUT_TOKENS": "15000",
    "BASH_DEFAULT_TIMEOUT_MS": "300000",
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1",
    "CLAUDE_CODE_DISABLE_TERMINAL_TITLE": "1",
    "DISABLE_AUTOUPDATER": "1",
    "ENABLE_STOP_REVIEW": "0",
    "CLAUDE_CODE_DISABLE_AUTO_MEMORY": "1"
  },
  "disableAgentView": true
}
