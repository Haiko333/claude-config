{
  "env": {
    "CLAUDE_CODE_SUBAGENT_MODEL": "sonnet",
    "ENABLE_STOP_REVIEW": "0",
    "SECURITY_GUIDANCE_COMMIT_REVIEW": "off"
  },
  "model": "opus",
  "statusLine": {
    "type": "command",
    "command": "bun $HOME/.claude/scripts/statusline/src/index.ts",
    "padding": 0
  },
  "skipDangerousModePermissionPrompt": true,
  "theme": "dark",
  "hooks": {
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "paplay /usr/share/sounds/Oxygen-Sys-App-Positive.ogg"
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "paplay /usr/share/sounds/freedesktop/stereo/complete.oga"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "aibp-base@aiblueprint": true,
    "clangd-lsp@claude-plugins-official": true,
    "ponytail@ponytail": true
  },
  "extraKnownMarketplaces": {
    "aiblueprint": {
      "source": {
        "source": "github",
        "repo": "melvynx/aiblueprint"
      }
    },
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail"
      }
    }
  },
  "autoCompactWindow": 300000
}
